# Step Cards — environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env or .env.local — only this .env.example.

# ---- Groq (LLM) ----
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# ---- Supabase ----
# Create a free project at https://supabase.com
# Then apply schema.sql at the repo root and run seed-demo.js for demo data.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# These VITE_* copies are needed because the browser bundle inlines them.
# The publishable key is safe to expose — Row-Level Security protects data.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Server-side only (never expose in VITE_*) ----
# Used for admin seeding scripts and server-only RPCs.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
